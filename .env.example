# ==============================================================================
# Portfolio Environment Blueprint (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# Application Domain & Canonical URL
NEXT_PUBLIC_SITE_URL=https://khalid.dev

# Contact Form Notification Integration (Optional: Discord Webhook, Resend, or SMTP)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_token
RESEND_API_KEY=re_123456789_abcdefg
CONTACT_RECIPIENT_EMAIL=khalid.dev.engineer@gmail.com

# ------------------------------------------------------------------------------
# GitHub Actions CI/CD Secrets (Configure in GitHub Repo > Settings > Secrets)
# ------------------------------------------------------------------------------
# SSH_HOST=54.123.45.67            # AWS EC2 Public IPv4 or Elastic IP
# SSH_USER=ubuntu                  # Default Ubuntu EC2 username
# SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----... # EC2 .pem key content
# SSH_PORT=22                      # SSH Port (default 22)
# GHCR_TOKEN=ghp_...               # GitHub Personal Access Token with read:packages permissions
